{
  "name": "hallowmarch-tools",
  "private": true,
  "description": "Test and lint tooling for The Hallowmarch. three.js is served to the headless browser locally; eslint lints the built module.",
  "scripts": {
    "resources": "node performance-resources.mjs",
    "resources:check": "node performance-resources.mjs --check",
    "resources:test": "node --test performance-resources/performance-resources.test.mjs"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "eslint": "^8.57.0",
    "playwright": "1.55.0"
  }
}
