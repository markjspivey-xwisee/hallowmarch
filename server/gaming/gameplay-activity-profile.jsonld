    {
      "id": "urn:interego:gaming:activity:object:agent",
      "type": "ActivityType",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "agent game activity"
      },
      "definition": {
        "en": "A concrete game control activity involving a verified agent controller. Its observation does not establish that controller\u2019s task performance or an outcome."
      }
