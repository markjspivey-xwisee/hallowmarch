  "templates": [
    {
      "id": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/templates/1.1.0/ability.executed",
      "type": "StatementTemplate",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "ability.executed observation"
      },
      "definition": {
        "en": "The owner browser observed a game ability execute. This records execution, not successful damage or demonstrated skill."
      },
      "verb": "urn:interego:gaming:activity:verb:ability.executed",
      "objectActivityType": "urn:interego:gaming:activity:object:ability",
      "rules": [
        {
          "location": "$.id",
          "presence": "included"
        },
        {
          "location": "$.actor.objectType",
          "presence": "included",
          "all": [
            "Agent"
          ]
        },
        {
          "location": "$.actor.account.homePage",
          "presence": "included",
          "all": [
            "https://identity.interego.xwisee.com"
          ]
        },
        {
          "location": "$.actor.account.name",
          "presence": "included"
        },
        {
          "location": "$.object.objectType",
          "presence": "included",
          "all": [
            "Activity"
          ]
        },
        {
          "location": "$.timestamp",
          "presence": "included"
        },
        {
          "location": "$.context.registration",
          "presence": "included"
        },
        {
          "location": "$.context.contextActivities.category[*].id",
          "presence": "included",
          "any": [
            "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0"
          ]
        },
        {
          "location": "$.context.extensions['urn:interego:gaming:activity:context'].eventType",
          "presence": "included",
          "all": [
            "ability.executed"
          ]
        },
        {
          "location": "$.result.extensions['urn:interego:gaming:activity:observation'].authority",
          "presence": "included",
          "all": [
            "owner-browser-observation"
          ]
        },
        {
          "location": "$.result.extensions['urn:interego:gaming:activity:observation'].competencyStatus",
          "presence": "included",
          "all": [
            "not-assessed"
          ]
        }
      ]
