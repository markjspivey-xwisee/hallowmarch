    {
      "id": "urn:interego:gaming:activity:context",
      "type": "ContextExtension",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "Observed game context"
      },
      "definition": {
        "en": "Identifies the concrete body, known controller, session game context and optional task or intervention links. Controller identity is separate from the statement actor. Unknown control must remain explicit; this extension grants no control or identity authority."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"schema\",\"eventType\",\"bodyId\",\"bodyKind\",\"controllerKind\",\"party\"],\"properties\":{\"schema\":{\"const\":\"hallowmarch.gameplay-event/v1\"},\"eventType\":{\"enum\":[\"ability.executed\",\"ability.refused\",\"combat.defeated\",\"combat.died\",\"combat.healed\",\"resource.gathered\",\"resource.harvested\",\"craft.completed\",\"craft.refused\",\"bounty.completed\",\"bounty.claimed\",\"supply.delivered\",\"path.completed\",\"character.respawned\",\"intervention.started\",\"agent.command-accepted\"]},\"bodyId\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":128},\"bodyKind\":{\"enum\":[\"character\",\"owned-unit\"]},\"controllerKind\":{\"enum\":[\"unattributed\",\"human-input\",\"agent\",\"companion-autonomy\"]},\"controllerId\":{\"type\":\"string\",\"pattern\":\"^did:\",\"maxLength\":512},\"grantId\":{\"type\":\"string\",\"pattern\":\"^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$\"},\"party\":{\"type\":\"boolean\"},\"realm\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":2},\"level\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":50},\"attemptId\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$\"},\"interventionId\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":64}},\"allOf\":[{\"if\":{\"properties\":{\"controllerKind\":{\"const\":\"agent\"}},\"required\":[\"controllerKind\"]},\"then\":{\"required\":[\"controllerId\"]}}]}"
    },
    {
      "id": "urn:interego:gaming:activity:observation",
      "type": "ResultExtension",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "Owner-browser observation provenance"
      },
      "definition": {
        "en": "Marks a record as owner-browser evidence with no assessed competency. Optional quantity and reason preserve only actual observations. The ordinal is local record ordering, not a count of learning achievements."
      },
      "inlineSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"authority\",\"competencyStatus\",\"historyOrdinal\"],\"properties\":{\"authority\":{\"const\":\"owner-browser-observation\"},\"competencyStatus\":{\"const\":\"not-assessed\"},\"quantity\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1000000000},\"reason\":{\"type\":\"string\",\"pattern\":\"^[a-z][a-z0-9_-]{0,63}$\"},\"historyOrdinal\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991}}}"
    }
