    {
      "id": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/patterns/1.1.0/observation-stream",
      "type": "Pattern",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "primary": true,
      "prefLabel": {
        "en": "Observed gameplay stream"
      },
      "definition": {
        "en": "One or more actual observations, in timestamp order within one session registration. The stream has no required completion, pass or intervention outcome. A fresh session has a fresh registration. This pattern describes observation records only."
      },
      "oneOrMore": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/patterns/1.1.0/observed-event"
    },
    {
      "id": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/patterns/1.1.0/ability-recovery",
      "type": "Pattern",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "primary": false,
      "prefLabel": {
        "en": "Ability refusal followed by execution"
      },
      "definition": {
        "en": "Secondary analytic pair of actual observations for the same ability object. Match only within the same profile version and registration, observing actor, body and controller context. Project relevant events for that identity before matching this two-statement sequence; unrelated observations may intervene in the full stream. A missing first or second event stays unmatched or incomplete. This motif describes temporal game observations, not learning or intervention effectiveness."
      },
      "sequence": [
        "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/templates/1.1.0/ability.refused",
        "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/templates/1.1.0/ability.executed"
      ]
    },
