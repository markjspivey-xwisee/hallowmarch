  "concepts": [
    {
      "id": "urn:interego:gaming:activity:verb:ability.executed",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "ability.executed"
      },
      "definition": {
        "en": "The owner browser observed a game ability execute. This records execution, not successful damage or demonstrated skill."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:ability.refused",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "ability.refused"
      },
      "definition": {
        "en": "The owner browser observed a game ability being refused. A reason may be retained; the event does not diagnose its cause."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:combat.defeated",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "combat.defeated"
      },
      "definition": {
        "en": "The owner browser observed a creature defeat credited to this game body. This is a game outcome, not a transferable competency."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:combat.died",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "combat.died"
      },
      "definition": {
        "en": "The owner browser observed this game body die. Death alone does not establish a knowledge, motivation or capability gap."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:combat.healed",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "combat.healed"
      },
      "definition": {
        "en": "The owner browser observed healing applied in the game. A retained quantity is the observed game amount."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:resource.gathered",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "resource.gathered"
      },
      "definition": {
        "en": "The owner browser observed resources gathered by the game body."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:resource.harvested",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "resource.harvested"
      },
      "definition": {
        "en": "The owner browser observed a harvest applied by the game body."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:craft.completed",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "craft.completed"
      },
      "definition": {
        "en": "The owner browser observed a crafting operation complete in the game."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:craft.refused",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "craft.refused"
      },
      "definition": {
        "en": "The owner browser observed a crafting operation refused. This records the refusal and its observed reason."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:bounty.completed",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "bounty.completed"
      },
      "definition": {
        "en": "The owner browser observed a game bounty satisfy its game completion condition."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:bounty.claimed",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "bounty.claimed"
      },
      "definition": {
        "en": "The owner browser observed the completed bounty reward being claimed in the game."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:supply.delivered",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "supply.delivered"
      },
      "definition": {
        "en": "The owner browser observed a supply delivery accepted by the game."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:path.completed",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "path.completed"
      },
      "definition": {
        "en": "The owner browser observed a game progression path complete. Game progression is not a learning or mastery assessment."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:character.respawned",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "character.respawned"
      },
      "definition": {
        "en": "The owner browser observed the game body respawn."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:intervention.started",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "intervention.started"
      },
      "definition": {
        "en": "The owner browser observed a selected support intervention start. Starting an intervention does not establish delivery completion or an effect."
      }
    },
    {
      "id": "urn:interego:gaming:activity:verb:agent.command-accepted",
      "type": "Verb",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "agent.command-accepted"
      },
      "definition": {
        "en": "The owner browser observed a verified agent command accepted for its authorized game body. Acceptance confirms the input was admitted, not that movement, combat, task completion or an effective outcome occurred. The observing owner remains the statement actor; the verified agent is controller context."
      }
    },
    {
      "id": "urn:interego:gaming:activity:object:ability",
      "type": "ActivityType",
      "inScheme": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "prefLabel": {
        "en": "ability game activity"
      },
      "definition": {
        "en": "A concrete ability game activity or game object identified by its stable game identifier. The type expresses game aboutness rather than an assessed competency."
      }
    },
