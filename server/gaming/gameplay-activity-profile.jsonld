{
  "id": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld",
  "@context": "https://w3id.org/xapi/profiles/context",
  "type": "Profile",
  "conformsTo": "https://w3id.org/xapi/profiles#1.0",
  "prefLabel": {
    "en": "Hallowmarch observed gameplay activity"
  },
  "definition": {
    "en": "Application vocabulary, statement templates and an observation-stream pattern for actual Hallowmarch gameplay observed by the owner browser. Records distinguish the authenticated observing owner, game body, controller and session. They describe game actions and outcomes without inferring learning, competency, mastery, causal intervention effects or server verification. Private own-pod records are not an assertion of LRS conformance."
  },
  "seeAlso": "https://github.com/markjspivey-xwisee/hallowmarch/blob/main/docs/gameplay-activity-profile.md",
  "versions": [
    {
      "id": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.1.0",
      "wasRevisionOf": [
        "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.0.0"
      ],
      "generatedAtTime": "2026-10-27T12:00:00Z"
    },
    {
      "id": "https://march-production-f6d9.up.railway.app/gaming/activity-profile.jsonld/versions/1.0.0",
      "generatedAtTime": "2026-10-17T03:39:57Z"
    }
  ],
