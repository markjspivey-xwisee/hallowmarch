{
  "id": "https://march-production-f6d9.up.railway.app/gaming/committed-activity-profile.jsonld",
  "@context": "https://w3id.org/xapi/profiles/context",
  "type": "Profile",
  "conformsTo": "https://w3id.org/xapi/profiles#1.0",
  "prefLabel": {
    "en": "Hallowmarch committed gameplay projection"
  },
  "definition": {
    "en": "An explicitly selected projection of committed authoritative game events. This does not relabel owner-browser observations or migrate existing legacy exports. An actual caller-supplied run registration partitions the stream; the Profile invents no initialization, completion, achievement or learner assessment. Profile support is not LRS conformance certification."
  },
  "seeAlso": "https://github.com/markjspivey-xwisee/hallowmarch/blob/main/docs/gameplay-activity-profile.md",
  "versions": [
